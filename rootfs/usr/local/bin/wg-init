#!/command/with-contenv bash
set -euo pipefail
umask 077

CONFIG_DIR="/config"
WG_DIR="${CONFIG_DIR}/wg"
WG_CONF="${WG_DIR}/wg0.conf"

SERVER_PORT="${SERVER_PORT:-51820}"
INTERNAL_SUBNET="${INTERNAL_SUBNET:-10.13.13.0/24}"

# SERVER_PORT is honored on every start (first-run config + the sync sed
# below) — reject garbage before it can end up inside wg0.conf.
if ! [[ "${SERVER_PORT}" =~ ^[0-9]{1,5}$ ]] || [ "${SERVER_PORT}" -lt 1 ] || [ "${SERVER_PORT}" -gt 65535 ]; then
    echo "[wg-init] ERROR: SERVER_PORT must be a port number 1-65535 (got: '${SERVER_PORT}')" >&2
    exit 1
fi

# Derive server IP from subnet (first usable: x.x.x.1)
SERVER_IP="${INTERNAL_SUBNET%.*}.1"
SUBNET_MASK="${INTERNAL_SUBNET#*/}"

mkdir -p "${WG_DIR}"
mkdir -p "${CONFIG_DIR}/peers"
# Retrofit existing installs — mkdir -p does not tighten pre-existing dirs
chmod 700 "${WG_DIR}" "${CONFIG_DIR}/peers"

if [ ! -f "${WG_CONF}" ]; then
    echo "[wg-init] First run — generating server keys and config"

    # The stack assumes a /24: add-peer allocates in the last octet and
    # svc-unbound derives its ACL as x.x.x.0/24. Reject anything else
    # before a broken wg0.conf gets persisted. Existing installs are not
    # re-validated — INTERNAL_SUBNET is ignored after first run anyway.
    if ! [[ "${INTERNAL_SUBNET}" =~ ^([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})\.0/24$ ]] ||
       [ "${BASH_REMATCH[1]}" -gt 255 ] || [ "${BASH_REMATCH[2]}" -gt 255 ] || [ "${BASH_REMATCH[3]}" -gt 255 ]; then
        echo "[wg-init] ERROR: INTERNAL_SUBNET must be a /24 in the form x.x.x.0/24 (got: '${INTERNAL_SUBNET}')" >&2
        exit 1
    fi

    # Generate server keypair
    SERVER_PRIVATE_KEY=$(wg genkey)
    SERVER_PUBLIC_KEY=$(echo "${SERVER_PRIVATE_KEY}" | wg pubkey)

    echo "${SERVER_PRIVATE_KEY}" > "${WG_DIR}/server_private.key"
    echo "${SERVER_PUBLIC_KEY}" > "${WG_DIR}/server_public.key"
    chmod 600 "${WG_DIR}/server_private.key"

    # Detect default outbound interface
    DEFAULT_IFACE=$(ip -o -4 route show default | awk '{print $5}' | head -1)
    if [ -z "${DEFAULT_IFACE}" ]; then
        echo "[wg-init] ERROR: no default route found — cannot detect outbound interface." >&2
        echo "[wg-init] Refusing to write a broken wg0.conf; will retry on next container start." >&2
        exit 1
    fi

    # Write server config
    cat > "${WG_CONF}" <<EOF
[Interface]
Address = ${SERVER_IP}/${SUBNET_MASK}, fd00::1/64
ListenPort = ${SERVER_PORT}
PrivateKey = ${SERVER_PRIVATE_KEY}
MTU = 1420
PostUp = iptables -t nat -A POSTROUTING -o ${DEFAULT_IFACE} -j MASQUERADE
PostUp = iptables -A FORWARD -i wg0 -j ACCEPT
PostUp = iptables -A FORWARD -o wg0 -m state --state RELATED,ESTABLISHED -j ACCEPT
PostUp = ip6tables -t nat -A POSTROUTING -o ${DEFAULT_IFACE} -j MASQUERADE || true
PostUp = ip6tables -A FORWARD -i wg0 -j ACCEPT || true
PostUp = ip6tables -A FORWARD -o wg0 -m state --state RELATED,ESTABLISHED -j ACCEPT || true
PostDown = iptables -t nat -D POSTROUTING -o ${DEFAULT_IFACE} -j MASQUERADE
PostDown = iptables -D FORWARD -i wg0 -j ACCEPT
PostDown = iptables -D FORWARD -o wg0 -m state --state RELATED,ESTABLISHED -j ACCEPT
PostDown = ip6tables -t nat -D POSTROUTING -o ${DEFAULT_IFACE} -j MASQUERADE || true
PostDown = ip6tables -D FORWARD -i wg0 -j ACCEPT || true
PostDown = ip6tables -D FORWARD -o wg0 -m state --state RELATED,ESTABLISHED -j ACCEPT || true
EOF

    echo "[wg-init] Server config created at ${WG_CONF}"
    echo "[wg-init] Server public key: ${SERVER_PUBLIC_KEY}"
else
    echo "[wg-init] Existing config found at ${WG_CONF}"

    # Sync ListenPort with SERVER_PORT — the compose port mapping follows
    # SERVER_PORT, so a stale ListenPort would leave the VPN unreachable.
    CURRENT_PORT=$(sed -n 's/^ListenPort *= *//p' "${WG_CONF}")
    if [ -n "${CURRENT_PORT}" ] && [ "${CURRENT_PORT}" != "${SERVER_PORT}" ]; then
        sed -i "s/^ListenPort *=.*/ListenPort = ${SERVER_PORT}/" "${WG_CONF}"
        chmod 600 "${WG_CONF}"
        echo "[wg-init] WARNING: SERVER_PORT changed (${CURRENT_PORT} -> ${SERVER_PORT}); updated ListenPort in wg0.conf"
        echo "[wg-init] WARNING: existing peer configs still point at port ${CURRENT_PORT} and will NOT connect"
        echo "[wg-init] WARNING: re-issue each peer (remove-peer <name>, then add-peer <name>) and update your router port forward"
    fi

    # INTERNAL_SUBNET cannot be changed in place — warn if it diverged.
    CURRENT_IP=$(grep '^Address' "${WG_CONF}" | grep -oE '[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+' | head -1 || true)
    if [ -n "${CURRENT_IP}" ] && [ "${CURRENT_IP}" != "${SERVER_IP}" ]; then
        echo "[wg-init] WARNING: INTERNAL_SUBNET (${INTERNAL_SUBNET}) does not match the existing server address (${CURRENT_IP})"
        echo "[wg-init] WARNING: INTERNAL_SUBNET only takes effect on first run — the existing subnet is kept"
        echo "[wg-init] WARNING: to change the subnet, delete ./config/wg and ./config/peers, restart, and re-issue all peers"
    fi
fi

chmod 600 "${WG_CONF}"

echo "[wg-init] WireGuard initialization complete"

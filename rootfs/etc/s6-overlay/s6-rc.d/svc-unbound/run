#!/command/with-contenv bash
set -euo pipefail

WG_CONF="/config/wg/wg0.conf"

# Derive the server IP and subnet from the persisted WireGuard config
# (single source of truth — wg-init wrote it from INTERNAL_SUBNET on first run)
SERVER_IP=$(sed -n 's|^Address *= *\([0-9.]*\)/.*|\1|p' "${WG_CONF}")
PREFIX=$(sed -n 's|^Address *= *[0-9.]*/\([0-9]*\).*|\1|p' "${WG_CONF}")
SUBNET="${SERVER_IP%.*}.0/${PREFIX}"

sed -e "s|@SERVER_IP@|${SERVER_IP}|g" \
    -e "s|@SUBNET@|${SUBNET}|g" \
    /etc/unbound/unbound.conf.template > /etc/unbound/unbound.conf

echo "[unbound] Refreshing DNSSEC root trust anchor"
mkdir -p /var/lib/unbound
# unbound-anchor exits 1 when it (re)creates the anchor from its builtin
# keys or the IANA certificate fallback — that is success, not an error.
unbound-anchor -a /var/lib/unbound/root.key || true
chown -R unbound:unbound /var/lib/unbound

echo "[unbound] Starting Unbound DNS resolver on ${SERVER_IP}:53"

# Run in foreground (-d)
exec unbound -d -c /etc/unbound/unbound.conf
